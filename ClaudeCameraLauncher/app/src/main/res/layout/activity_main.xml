<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera mode -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/shutterButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_circle_button_accent"
        android:contentDescription="@string/take_photo"
        android:padding="18dp"
        android:src="@drawable/ic_camera_shutter" />

    <!-- Edit mode: photo + drawing/crop overlay, fullscreen so the image sits
         centered by DrawView itself; the toolbar and corner buttons float on top. -->
    <FrameLayout
        android:id="@+id/editContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.myappstore.claudecam.DrawView
            android:id="@+id/drawView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.myappstore.claudecam.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Floating tool row -->
        <LinearLayout
            android:id="@+id/toolRow"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/cropButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/crop"
                android:src="@drawable/ic_crop" />

            <ImageButton
                android:id="@+id/markerButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/marker"
                android:src="@drawable/ic_marker" />

            <ImageButton
                android:id="@+id/blackoutButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/blackout"
                android:src="@drawable/ic_blackout" />

            <ImageButton
                android:id="@+id/rotateButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/rotate"
                android:src="@drawable/ic_rotate" />

            <ImageButton
                android:id="@+id/undoButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/undo"
                android:src="@drawable/ic_undo" />

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_clear" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/surface_translucent_light" />

            <View
                android:id="@+id/colorRed"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_margin="4dp"
                android:background="#FF3B30" />

            <View
                android:id="@+id/colorYellow"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_margin="4dp"
                android:background="#FFCC00" />

            <View
                android:id="@+id/colorGreen"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_margin="4dp"
                android:background="#34C759" />

            <View
                android:id="@+id/colorWhite"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_margin="4dp"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Crop confirm/cancel row, shown only while cropping -->
        <LinearLayout
            android:id="@+id/cropConfirmRow"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/cropCancelButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_clear" />

            <ImageButton
                android:id="@+id/cropConfirmButton"
                style="@style/ToolIconButton"
                android:contentDescription="@string/confirm"
                android:src="@drawable/ic_check" />
        </LinearLayout>

        <!-- Retake: small round button, bottom-left corner -->
        <ImageButton
            android:id="@+id/retakeButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="20dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/retake"
            android:padding="13dp"
            android:src="@drawable/ic_camera_shutter" />

        <!-- Share to Claude: small round accent button, bottom-right corner -->
        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_circle_button_accent"
            android:contentDescription="@string/share_to_claude"
            android:padding="13dp"
            android:src="@drawable/ic_claude_mark" />
    </FrameLayout>

</FrameLayout>
