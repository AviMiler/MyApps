<?xml version="1.0" encoding="utf-8"?>
<!-- Colors are applied at runtime from the user's ColorScheme (see MainActivity.applyTheme). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Everything above the day sheet; hidden while the day details are full screen -->
        <LinearLayout
            android:id="@+id/top_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <!-- Top app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/title_area"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/title_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/title_dropdown"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_drop_down" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/button_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/button_today"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/today">

                <TextView
                    android:id="@+id/today_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/button_sync"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sync_now"
                android:scaleType="center"
                android:src="@drawable/ic_sync" />

            <ImageView
                android:id="@+id/button_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/customize"
                android:scaleType="center"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/button_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous_month"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_right" />

            <ImageView
                android:id="@+id/button_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_month"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_left" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/weekday_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp" />

        <com.myappstore.hebrewcalendar.ui.components.MonthSwipeLayout
            android:id="@+id/month_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        </LinearLayout>

        <!-- Day details as a bottom sheet -->
        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <FrameLayout
                android:id="@+id/sheet_handle_area"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:contentDescription="@string/expand_day">

                <View
                    android:id="@+id/sheet_handle"
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <com.myappstore.hebrewcalendar.ui.components.SheetScrollView
                android:id="@+id/sheet_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="88dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/sheet_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/sheet_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/sheet_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="@string/today"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sheet_holidays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="4dp" />

                    <TextView
                        android:id="@+id/permission_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/events_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/zmanim_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="4dp" />

                    <LinearLayout
                        android:id="@+id/zmanim_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.myappstore.hebrewcalendar.ui.components.SheetScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Extended FAB -->
    <TextView
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:drawablePadding="12dp"
        android:elevation="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:text="@string/new_event"
        android:textSize="16sp" />
</FrameLayout>
